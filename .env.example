# Variables a nivel de docker-compose (raíz del repo).
# Copia este archivo a .env  →  cp .env.example .env
#
# NOTA: las claves de la app (WEATHERAPI_KEY, JWT_SECRET, etc.) van en
# backend/.env, no aquí. Esto es solo para el build del frontend y el túnel.

# URL del backend que el frontend hornea en build-time.
# - Local / LAN:   http://localhost:3001/api
# - Con túnel:     https://api.tudominio.com/api
VITE_API_URL=http://localhost:3001/api

# Token del túnel de Cloudflare (perfil "tunnel").
# Se obtiene en Cloudflare Zero Trust → Networks → Tunnels → tu túnel.
# Déjalo vacío si no usas el túnel.
TUNNEL_TOKEN=
