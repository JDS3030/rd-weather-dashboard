BACKEND_URL=http://localhost:3001/api

# Telegram (notificador activo)
# Obtener token: hablar con @BotFather en Telegram → /newbot
# Obtener chat_id: enviar mensaje al bot y consultar https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# IDs de chat separados por coma (usuarios o grupos)
TELEGRAM_CHAT_IDS=123456789,987654321

# Twilio WhatsApp (legado — conservado para compatibilidad)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
EMERGENCY_CONTACTS=whatsapp:+1809XXXXXXX,whatsapp:+1829XXXXXXX

# Configuración de horarios
DAILY_REPORT_HOUR=7
EMERGENCY_CHECK_INTERVAL_MINUTES=5
EMERGENCY_REPORT_INTERVAL_HOURS=1
